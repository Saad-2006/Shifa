# Copy to .env.local (never commit .env.local).

# Gemini API key from https://aistudio.google.com/apikey (server-side only).
# Without it the app still runs: the sample report and offline answers work.
GEMINI_API_KEY=

# Optional. Ordered, comma-separated model chain: Shifa tries them in order and moves on after a
# 404, 429, 5xx/overload or a slow answer (25 s per model for reading, 20 s to the first word for chat).
# Default when empty: gemini-3.5-flash,gemini-flash-lite-latest,gemini-flash-latest
# Run `node scripts/check-models.mjs --ping` to see which ones your key can use and how fast they are.
GEMINI_MODEL=gemini-3.5-flash,gemini-flash-lite-latest

# Optional demo passcode. When set, the app asks for it before calling the APIs.
SHIFA_ACCESS_CODE=

# Optional Google sign-in (NextAuth). Leave GOOGLE_* empty to run without accounts (guest mode).
# Create an OAuth client (Web application) at https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origins: http://localhost:3000 and https://<your-app>.vercel.app
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
#                                  https://<your-app>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret for signing sessions: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Local only. On Vercel leave it unset (NextAuth uses the deployment URL) or set your https URL.
NEXTAUTH_URL=http://localhost:3000
# true = everyone must sign in before using the AI; false = sign-in optional (guests allowed)
SHIFA_REQUIRE_SIGNIN=false
